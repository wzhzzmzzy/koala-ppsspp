+// The standalone launcher owns settings, save slots and diagnostics. Do not expose
+// upstream debugger/symbol/network actions that this app does not implement.
+-(void)koalaRequest:(NSMenuItem *)item {
+    NSString *root = @(getenv("KOALA_CONTROL_DIR"));
+    [item.representedObject writeToFile:[root stringByAppendingPathComponent:@"ui-request.txt"]
+                           atomically:YES encoding:NSUTF8StringEncoding error:nil];
+}
+-(BOOL)validateMenuItem:(NSMenuItem *)item {
+    if (item.action != @selector(koalaRequest:)) return YES;
+    NSString *op = item.representedObject;
+    if ([op isEqualToString:@"pause"]) item.title = Core_IsStepping() ? @"继续" : @"暂停";
+    if ([op isEqualToString:@"mute"]) item.title = g_Config.bEnableSound ? @"静音" : @"开启声音";
+    if ([op isEqualToString:@"hud"]) item.state = g_Config.iShowStatusFlags ? NSControlStateValueOn : NSControlStateValueOff;
+    if ([op isEqualToString:@"load 1"]) {
+        return PSP_IsInited() && File::Exists(SaveState::GenerateSaveSlotPath(SaveState::GetGamePrefix(g_paramSFO), 1, "ppst"));
+    }
+    if ([op isEqualToString:@"pause"] || [op isEqualToString:@"mute"] || [op isEqualToString:@"save 1"] || [op isEqualToString:@"hud"]) return PSP_IsInited();
+    return YES;
+}
+-(void)setupKoalaMenus {
+    NSMenu *bar = [[NSMenu alloc] init];
+    NSArray *groups = @[
+        @[@"Koala PSP Player", @[
+            @[@"回到游戏库", @"library", @"1"], @[@"播放设置…", @"settings", @","],
+            @[@"保存并结束游戏", @"quit", @"q"]]],
+        @[@"游戏", @[
+            @[@"暂停", @"pause", @"p"], @[@"保存手动存档", @"save 1", @"s"],
+            @[@"读取手动存档", @"load 1", @"l"], @[@"静音", @"mute", @""]]],
+        @[@"诊断", @[
+            @[@"显示性能 HUD", @"hud", @"h"], @[@"日志与调试…", @"diagnostics", @"d"]]],
+        @[@"帮助", @[@[@"键盘与手柄示意图…", @"controls", @"/"]]]
+    ];
+    for (NSArray *group in groups) {
+        NSMenuItem *parent = [[NSMenuItem alloc] initWithTitle:group[0] action:nil keyEquivalent:@""];
+        NSMenu *menu = [[NSMenu alloc] initWithTitle:group[0]];
+        for (NSArray *entry in group[1]) {
+            NSMenuItem *item = [[NSMenuItem alloc] initWithTitle:entry[0] action:@selector(koalaRequest:) keyEquivalent:entry[2]];
+            item.target = self; item.representedObject = entry[1]; [menu addItem:item];
+        }
+        parent.submenu = menu; [bar addItem:parent];
+    }
+    [NSApp setWindowsMenu:nil]; [NSApp setHelpMenu:nil]; [NSApp setMainMenu:bar];
+    if (const char *logDir = getenv("KOALA_LOG_DIR")) {
+        NSData *data = [NSJSONSerialization dataWithJSONObject:groups options:NSJSONWritingPrettyPrinted error:nil];
+        [data writeToFile:[@(logDir) stringByAppendingPathComponent:@"native-menus.json"] atomically:YES];
+    }
+}
